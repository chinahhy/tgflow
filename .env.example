# 部署用 Docker Hub 用户名，与 GitHub 用户名无必然关系。
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest
PORT=6543
DATA_DIR=./data
HTTP_ALLOWED_ORIGINS=http://10.0.0.104:6543

# 从 https://my.telegram.org 的 API development tools 获取。
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_LOG_LEVEL=0
LOG_LEVEL=INFO

# 可选：容器进程对挂载目录使用的 UID/GID。
PUID=0
PGID=0

# Compose 示例固定用于局域网 HTTP，HTTP_SECURE_COOKIES=false。
# 使用 HTTPS 时修改 Compose 中的 HTTP_SECURE_COOKIES 为 "true"，
# 并把 HTTP_ALLOWED_ORIGINS 改为实际 HTTPS 来源。
# 默认 SQLite；可选分享功能已关闭，无需配置外部数据库或 qBittorrent。
