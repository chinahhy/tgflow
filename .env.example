# 部署用 Docker Hub 用户名，与 GitHub 用户名无必然关系。
DOCKERHUB_USERNAME=hoya0803
IMAGE_TAG=dev
PORT=6543
# SSD 上的应用状态目录：数据库、账号会话、索引、配置及日志。
CONFIG_DIR=./config
# HDD 上的下载目录：包含下载临时文件和已完成文件。
DOWNLOAD_DIR=./downloads
HTTP_ALLOWED_ORIGINS=http://10.0.0.104:6543
HTTP_SECURE_COOKIES=false

# 从 https://my.telegram.org 的 API development tools 获取。
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_LOG_LEVEL=0
LOG_LEVEL=INFO

# 可选：容器进程对挂载目录使用的 UID/GID。
PUID=0
PGID=0

# 局域网 HTTP 使用 HTTP_SECURE_COOKIES=false。
# HTTPS 域名访问时设为 true，并把 HTTP_ALLOWED_ORIGINS 改为完整 HTTPS 来源，
# 使用非默认端口时必须包含端口；外层反代保留 Host 并传入 X-Forwarded-Proto。
# 默认 SQLite；可选分享功能已关闭，无需配置外部数据库或 qBittorrent。
