# dev 镜像地址已固定在 Compose，无需配置仓库用户名或标签。
PORT=8026
# SSD 上的应用状态目录：数据库、账号会话、索引、配置及日志。
CONFIG_DIR=./config
# HDD 上的下载目录：包含下载临时文件和已完成文件。
DOWNLOAD_DIR=./downloads

# 从 https://my.telegram.org 的 API development tools 获取。
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_LOG_LEVEL=0

# 可选：容器进程对挂载目录使用的 UID/GID。
PUID=0
PGID=0

# HTTP / HTTPS 和当前域名自动识别，通常无需设置来源或 Cookie 参数。
# 如需高级覆盖，请在 Compose 的 environment 中显式添加：
# HTTP_ALLOWED_ORIGINS（额外跨域来源，多个值用逗号分隔）。
# HTTP_SECURE_COOKIES（auto / true / false，默认 auto）。
# 仅写在本 .env 文件中不会将这些高级参数传入容器。
# 默认 SQLite；dev 已在代码中禁用平台分享 / BT 做种，环境变量无法开启。
# 容器目录默认 /app/data 与 /downloads，日志默认 INFO；无需配置。
# 镜像自带 Docker 定期健康检查，无需在 Compose 或应用中另建任务。
